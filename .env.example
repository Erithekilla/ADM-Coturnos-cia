APP_NAME="Coturnos & Cia"
APP_ENV=local
# ==============================================================================
# ATENÇÃO CRÍTICA SOBRE A APP_KEY (CRIPTOGRAFIA AES-256):
# Esta chave é usada pelo Laravel para criptografar dados sensíveis (LGPD) como
# CPF e Telefone (casts 'encrypted' em User.php).
# - Se você for rodar o banco do zero localmente: execute 'php artisan key:generate'.
# - Se a equipe for compartilhar um dump/backup do banco com usuários já cadastrados:
#   TODOS DEVEM USAR EXATAMENTE A MESMA APP_KEY para conseguir descriptografar os dados.
# ==============================================================================
APP_KEY=
APP_DEBUG=true
APP_TIMEZONE=America/Sao_Paulo
APP_URL=http://localhost

APP_LOCALE=pt_BR
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=pt_BR

APP_MAINTENANCE_DRIVER=file
PHP_CLI_SERVER_WORKERS=4
BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# ==============================================================================
# BANCO DE DADOS
# Opção 1 (Local Rápido): SQLite
DB_CONNECTION=sqlite

# Opção 2 (Oficial Docker Sail - Ryan Rangel):
# DB_CONNECTION=mysql
# DB_HOST=mysql
# DB_PORT=3306
# DB_DATABASE=coturnos_cia
# DB_USERNAME=sail
# DB_PASSWORD=password
# ==============================================================================

SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database
CACHE_STORE=database
CACHE_PREFIX=

# Redis (Semana 3 - Ryan Rangel)
REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# E-mail / Mailpit (Semana 4 - Ryan Rangel)
MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="contato@coturnosecia.com.br"
MAIL_FROM_NAME="${APP_NAME}"

# ==============================================================================
# INTEGRAÇÕES & SERVIÇOS EXTERNOS (SANDBOX / DESENVOLVIMENTO)
# ==============================================================================

# SuperFrete (Cálculo de Frete / CEP)
SUPER_FRETE_TOKEN=
SUPER_FRETE_URL="https://sandbox.superfrete.com/api/v0/calculator"

# Mercado Pago Sandbox (Checkout Transparente PIX & Cartão - Marcelo Rezende)
MERCADO_PAGO_PUBLIC_KEY=
MERCADO_PAGO_ACCESS_TOKEN=
MERCADO_PAGO_WEBHOOK_SECRET=

# Cloudinary (Galeria de Coturnos - Erick Montassier)
CLOUDINARY_URL=

# OAuth Socialite (Semana 2 - Luis Eduardo)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI="${APP_URL}/api/v1/auth/google/callback"

FACEBOOK_CLIENT_ID=
FACEBOOK_CLIENT_SECRET=
FACEBOOK_REDIRECT_URI="${APP_URL}/api/v1/auth/facebook/callback"

APPLE_CLIENT_ID=
APPLE_CLIENT_SECRET=
APPLE_REDIRECT_URI="${APP_URL}/api/v1/auth/apple/callback"

VITE_APP_NAME="${APP_NAME}"
